---
import '../styles/global.css';
import interUrl from '../assets/fonts/inter-latin-wght-normal.woff2?url';
import monoUrl from '../assets/fonts/jetbrains-mono-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';

interface Props {
  /** Page title. Omit on the home page. */
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** Keep the page out of search indexes (drafts, 404). */
  noindex?: boolean;
  /** Class for <body>, for page-level layout hooks. */
  bodyClass?: string;
  /** Leave out the site header and footer. Used by the terminal page. */
  bare?: boolean;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  noindex = false,
  bodyClass,
  bare = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b0c0e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline src="/theme-init.js"></script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? `${site.name}, ${site.role}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    {!bare && <Header />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }
</style>
