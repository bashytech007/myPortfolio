---
import { nav, site } from '../lib/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  !href.includes('#') && (path === href || path.startsWith(`${href}/`));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <svg class="brand__mark" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M4 7l6 5-6 5" fill="none" class="brand__chevron" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M12.5 18H20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
      </svg>
      <span>{site.name}</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to light theme">
      <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
        <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
      <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M20 14.2A8 8 0 0 1 9.8 4 8 8 0 1 0 20 14.2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    border-block-end: var(--hairline) solid var(--border);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand toggle'
      'nav nav';
    align-items: center;
    column-gap: var(--s-2);
  }

  .brand {
    grid-area: brand;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 3.5rem;
    color: var(--text);
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--text);
  }

  .brand__chevron {
    stroke: var(--accent);
  }

  .site-nav {
    grid-area: nav;
    margin-inline: calc(var(--s-1) * -1);
    border-block-start: var(--hairline) solid var(--border);
  }

  .site-nav ul {
    display: flex;
    justify-content: space-between;
  }

  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--s-1);
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--text);
  }

  .site-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    inset-inline: var(--s-1);
    inset-block-end: -1px;
    height: 2px;
    background: var(--accent);
  }

  .theme-toggle {
    grid-area: toggle;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-inline-end: -0.625rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    transition: color 120ms var(--ease);
  }

  .theme-toggle:hover {
    color: var(--text);
  }

  .theme-toggle:focus-visible {
    outline-offset: -2px;
    border-radius: var(--radius);
  }

  /* The toggle needs script, so it only shows once script has run. */
  :global(html:not(.js)) .theme-toggle {
    visibility: hidden;
  }

  /* Dark theme offers the sun (switch to light); light theme offers the moon. */
  .theme-toggle__moon,
  :global([data-theme='light']) .theme-toggle__sun {
    display: none;
  }

  :global([data-theme='light']) .theme-toggle__moon {
    display: block;
  }

  @media (min-width: 40rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto auto;
      grid-template-areas: 'brand nav toggle';
      column-gap: var(--s-3);
    }

    .brand {
      min-height: 4rem;
    }

    .site-nav {
      margin-inline: 0;
      border-block-start: 0;
    }

    .site-nav ul {
      gap: var(--s-2);
    }

    .site-nav a {
      min-height: 4rem;
    }
  }
</style>
