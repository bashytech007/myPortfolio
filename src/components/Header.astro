---
import { nav, site, terminal } from '../lib/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  !href.includes('#') && (path === href || path.startsWith(`${href}/`));
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <svg class="brand__mark" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M4 7l6 5-6 5" fill="none" class="brand__chevron" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M12.5 18H20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
      </svg>
      <span>{site.name}</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item, i) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="site-nav__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="site-nav__text">{item.label}</span>
              </a>
            </li>
          ))
        }
        <li class="site-nav__terminal">
          <a class="term-link" href={terminal.href}>
            <span class="term-link__glyph" aria-hidden="true">&gt;_</span>
            {terminal.label}
          </a>
        </li>
      </ul>
    </nav>

    <div class="site-header__tools">
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to light theme">
        <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M20 14.2A8 8 0 0 1 9.8 4 8 8 0 1 0 20 14.2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
        </svg>
      </button>
      <button
        type="button"
        class="menu-toggle label"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span class="menu-toggle__open">Menu</span>
        <span class="menu-toggle__close">Close</span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    border-block-end: var(--hairline) solid transparent;
    background: var(--bg);
    transition: border-color var(--dur) var(--ease);
  }

  @supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .site-header {
      background: color-mix(in srgb, var(--bg) 80%, transparent);
      -webkit-backdrop-filter: saturate(1.4) blur(14px);
      backdrop-filter: saturate(1.4) blur(14px);
    }
  }

  /* The bottom edge appears once the page has scrolled, and while the phone
     menu is open. Without script it is always there. */
  .site-header[data-scrolled],
  .site-header[data-menu-open],
  :global(html:not(.js)) .site-header {
    border-block-end-color: var(--border);
  }

  .site-header[data-menu-open] {
    background: var(--bg);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--s-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: var(--header-h);
    color: var(--text);
    font-size: var(--text-md);
    font-weight: 650;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover {
      color: var(--text);
    }
  }

  .brand__chevron {
    stroke: var(--accent);
  }

  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin-inline-end: -0.625rem;
  }

  /* Phone: the links live in a panel under the bar, opened by the Menu
     button. Without script the panel is simply always open. */

  .site-nav {
    order: 3;
    flex: 0 0 100%;
    display: none;
    max-height: calc(100dvh - var(--header-h));
    padding-block: var(--s-2) var(--s-4);
    border-block-start: var(--hairline) solid var(--border);
    overflow-y: auto;
  }

  .site-header[data-menu-open] .site-nav,
  :global(html:not(.js)) .site-nav {
    display: block;
  }

  .site-nav li + li {
    border-block-start: var(--hairline) solid var(--border);
  }

  .site-nav a {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    padding-block: var(--s-2);
    color: var(--text);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .site-nav a[aria-current] {
    color: var(--accent);
  }

  .site-nav__num {
    min-width: 2.25ch;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--track-label);
    color: var(--muted);
  }

  .term-link__glyph {
    min-width: 2.25ch;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--accent);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.625rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text);
    transition: transform var(--dur-press) var(--ease-out);
  }

  .menu-toggle__close,
  .menu-toggle[aria-expanded='true'] .menu-toggle__open {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__close {
    display: inline;
  }

  :global(html:not(.js)) .menu-toggle {
    display: none;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--muted);
    transition:
      color var(--dur) var(--ease),
      transform var(--dur-press) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .theme-toggle:active,
    .menu-toggle:active {
      transform: scale(0.95);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .theme-toggle:hover {
      color: var(--text);
    }
  }

  .theme-toggle:focus-visible,
  .menu-toggle:focus-visible {
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }

  /* The toggle needs script, so it only shows once script has run. */
  :global(html:not(.js)) .theme-toggle {
    visibility: hidden;
  }

  /* Dark theme offers the sun (switch to light); light theme offers the moon. */
  .theme-toggle__moon,
  :global([data-theme='light']) .theme-toggle__sun {
    display: none;
  }

  :global([data-theme='light']) .theme-toggle__moon {
    display: block;
  }

  /* From 48rem: one row. Links are small tracked labels with an underline
     that grows from the left on hover. */

  @media (min-width: 48rem) {
    .site-header__inner {
      flex-wrap: nowrap;
    }

    .site-nav,
    :global(html:not(.js)) .site-nav {
      order: 0;
      flex: 0 1 auto;
      display: block;
      max-height: none;
      margin-inline-start: auto;
      padding-block: 0;
      border-block-start: 0;
      overflow: visible;
    }

    .site-nav ul {
      display: flex;
      align-items: center;
      gap: var(--s-4);
    }

    .site-nav li + li {
      border-block-start: 0;
    }

    .site-nav__num {
      display: none;
    }

    .site-nav a {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: var(--header-h);
      padding-block: 0;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: var(--text-label);
      font-weight: 500;
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      transition: color var(--dur) var(--ease);
    }

    .site-nav a[aria-current] {
      color: var(--text);
    }

    @media (hover: hover) and (pointer: fine) {
      .site-nav a:hover {
        color: var(--text);
      }
    }

    .site-nav li:not(.site-nav__terminal) a::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      inset-block-end: calc(50% - 0.875rem);
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--dur-move) var(--ease-out);
    }

    .site-nav li:not(.site-nav__terminal) a[aria-current]::after {
      transform: scaleX(1);
    }

    @media (hover: hover) and (pointer: fine) {
      .site-nav li:not(.site-nav__terminal) a:hover::after {
        transform: scaleX(1);
      }
    }

    .site-nav a[aria-current]::after {
      background: var(--accent);
    }

    /* The terminal is a different kind of destination, so it is boxed. */
    .site-nav .term-link {
      min-height: 2rem;
      padding-inline: 0.75rem;
      border: var(--hairline) solid var(--border-strong);
      border-radius: var(--radius-pill);
      color: var(--text);
      transition:
        border-color var(--dur) var(--ease),
        background-color var(--dur) var(--ease),
        transform var(--dur-press) var(--ease-out);
    }

    @media (prefers-reduced-motion: no-preference) {
      .site-nav .term-link:active {
        transform: scale(0.97);
      }
    }

    @media (hover: hover) and (pointer: fine) {
      .site-nav .term-link:hover {
        border-color: var(--accent);
        background: var(--accent-wash);
      }
    }

    .term-link__glyph {
      min-width: 0;
      font-size: var(--text-xs);
    }

    .menu-toggle {
      display: none;
    }

    .site-header__tools {
      margin-inline-start: calc(var(--s-1) * -1);
    }
  }
</style>
