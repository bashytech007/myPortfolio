---
import { links, site, terminal } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <p class="site-footer__name" aria-hidden="true">{site.name}</p>
      <a class="label arrow-link site-footer__up" href="#main">Back to top</a>
    </div>

    <div class="site-footer__meta">
      <p class="label">&copy; {year} {site.name} / {site.location}</p>
      <ul class="site-footer__links" aria-label="Site and profiles">
        <li><a class="label" href="/security">How this site is hardened</a></li>
        <li><a class="label" href={terminal.href}>{terminal.label}</a></li>
        {
          links.social.map((item) => (
            <li>
              <a class="label" href={item.href} rel="me noopener noreferrer">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--section-gap);
    border-block-start: var(--hairline) solid var(--border);
  }

  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-3);
    padding-block: var(--s-8) var(--s-6);
  }

  /* The name once more, large, as the last thing on the page. */
  .site-footer__name {
    font-size: clamp(2.75rem, 11vw, 8rem);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }

  .site-footer__up::after {
    content: '\2191'; /* up arrow */
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .site-footer__up:hover::after {
      transform: translateY(-3px);
    }
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-1) var(--s-4);
    padding-block: var(--s-2) var(--s-3);
    border-block-start: var(--hairline) solid var(--border);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-3);
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__links a:hover {
      color: var(--text);
    }
  }

  @media (min-width: 48rem) {
    .site-footer__top {
      padding-block: var(--s-12) var(--s-8);
    }
  }
</style>
