---
/**
 * One project in the grid. The same unit every time: screenshot, numeral and
 * category, title, summary, tools, links.
 */
import { Image } from 'astro:assets';
import { isExternal, type Project } from '../lib/content';

interface Props {
  project: Project;
  /** Position in the grid, starting at 1. */
  number: number;
  /** Heading level for the title, so the card fits the page outline. */
  level?: 2 | 3;
  /** `sizes` attribute for the screenshot. */
  sizes?: string;
  /** Load the screenshot straight away. Use for a card that starts on screen. */
  priority?: boolean;
}

const {
  project,
  number,
  level = 3,
  priority = false,
  sizes = '(min-width: 74rem) 512px, (min-width: 52rem) 44vw, calc(100vw - 2.5rem)',
} = Astro.props;
const { title, summary, kind, tags, image, imageAlt, live, liveLabel, source, draft } = project.data;
const Heading = `h${level}` as 'h2' | 'h3';
---

<article class="project">
  <div class:list={['project__media', { 'project__media--empty': !image }]}>
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt ?? ''}
          widths={[480, 720, 1080, 1440]}
          sizes={sizes}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
        />
      ) : (
        <p class="label">TODO: add a screenshot</p>
      )
    }
  </div>

  <p class="project__meta">
    <span class="project__num" aria-hidden="true">{String(number).padStart(2, '0')}</span>
    <span class:list={['label', { 'label--accent': kind === 'security' }]}>{kind}</span>
    {draft && <span class="tag tag--draft">Draft</span>}
  </p>

  <Heading class="project__title">{title}</Heading>
  <p class="project__summary">{summary}</p>

  {
    tags.length > 0 && (
      <ul class="project__tools" aria-label="Built with">
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }

  {
    (live || source) && (
      <p class="project__links">
        {live && (
          <a
            class="arrow-link"
            href={live}
            data-external={isExternal(live) ? '' : undefined}
            rel={isExternal(live) ? 'noopener noreferrer' : undefined}
          >
            {liveLabel}
            <span class="visually-hidden">: {title}</span>
          </a>
        )}
        {source && (
          <a class="arrow-link" href={source} data-external rel="noopener noreferrer">
            Source
            <span class="visually-hidden">: {title}</span>
          </a>
        )}
      </p>
    )
  }
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* The screenshot leads. It sits in a frame with a hairline and scales up
     slightly inside that frame on hover. */
  .project__media {
    aspect-ratio: 16 / 10;
    border: var(--hairline) solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition: border-color var(--dur) var(--ease);
  }

  .project__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform var(--dur-move) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .project:hover .project__media {
      border-color: var(--border-strong);
    }
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .project:hover .project__media :global(img) {
      transform: scale(1.02);
    }
  }

  /* No screenshot yet: a hatched frame that says so. */
  .project__media--empty {
    display: grid;
    place-items: center;
    padding: var(--s-3);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 0.75rem,
      var(--border) 0.75rem calc(0.75rem + 1px)
    );
    text-align: center;
  }

  .project__meta {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    margin-block-start: var(--s-3);
  }

  .project__num {
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--muted);
    transition: color var(--dur) var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .project:hover .project__num {
      color: var(--accent);
    }
  }

  .project__meta .label {
    margin-inline-start: auto;
    text-align: end;
  }

  .project__meta .tag {
    align-self: center;
  }

  .project__title {
    overflow-wrap: anywhere;
    margin-block-start: var(--s-2);
    font-size: var(--text-2xl);
    line-height: 1.1;
    letter-spacing: var(--track-tight);
  }

  .project__summary {
    overflow-wrap: anywhere;
    max-width: 32em;
    margin-block-start: var(--s-2);
    color: var(--muted);
    font-size: var(--text-md);
    line-height: 1.6;
  }

  /* Tools as a line of text separated by slashes, not boxes. */
  .project__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-block-start: var(--s-3);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .project__tools li + li::before {
    content: '/';
    margin-inline-end: 0.75rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    margin-block-start: var(--s-3);
  }
</style>
