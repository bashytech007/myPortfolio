---
/** Projects without a screenshot, as a numbered index. */
import type { Project } from '../lib/content';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ol class="rows index">
  {
    projects.map(({ data }, i) => (
      <li class="build">
        <span class="label build__num" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <div class="build__main">
          <h3 class="build__title">{data.title}</h3>
          <p class="build__summary">{data.summary}</p>
        </div>
        <ul class="tags" aria-label="Tags">
          {data.tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
        <p class="build__links">
          {data.live && (
            <a class="arrow-link" href={data.live} data-external rel="noopener noreferrer">
              Live
              <span class="visually-hidden">: {data.title}</span>
            </a>
          )}
          {data.source && (
            <a class="arrow-link" href={data.source} data-external rel="noopener noreferrer">
              Source
              <span class="visually-hidden">: {data.title}</span>
            </a>
          )}
        </p>
      </li>
    ))
  }
</ol>

<style>
  .build {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--s-2);
    padding-block: var(--s-3);
  }

  .build > :not(.build__num) {
    grid-column: 2;
  }

  .build__num {
    line-height: 1.75rem;
    transition: color 200ms var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .build:hover .build__num {
      color: var(--accent);
    }
  }

  .build__title {
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }

  .build__summary {
    max-width: var(--measure);
    margin-block-start: 0.25rem;
    color: var(--muted);
    font-size: var(--text-md);
    line-height: 1.55;
  }

  .build__links {
    display: flex;
    gap: var(--s-3);
  }

  @media (min-width: 60rem) {
    .build {
      grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 16rem) 8.5rem;
      gap: var(--s-4);
      align-items: start;
      padding-block: var(--s-4);
    }

    .build > :not(.build__num) {
      grid-column: auto;
    }

    .build__links {
      justify-content: flex-end;
    }
  }
</style>
