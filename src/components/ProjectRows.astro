---
import type { Project } from '../lib/content';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ul class="rows">
  {
    projects.map(({ data }) => (
      <li class="build">
        <div class="build__main">
          <h3 class="build__title">{data.title}</h3>
          <p class="build__summary">{data.summary}</p>
        </div>
        <ul class="tags" aria-label="Tags">
          <li class="tag">{data.kind}</li>
          {data.tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
        <p class="build__links">
          {data.live && (
            <a class="text-link" href={data.live} rel="noopener noreferrer">
              Live
              <span class="visually-hidden">: {data.title}</span>
            </a>
          )}
          {data.source && (
            <a class="text-link" href={data.source} rel="noopener noreferrer">
              Source
              <span class="visually-hidden">: {data.title}</span>
            </a>
          )}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .build {
    display: grid;
    gap: var(--s-2);
    padding-block: var(--s-3);
  }

  .build__title {
    font-size: var(--text-body);
    letter-spacing: -0.01em;
  }

  .build__summary {
    max-width: var(--measure);
    margin-block-start: 0.25rem;
    color: var(--muted);
    font-size: var(--text-md);
    line-height: 1.55;
  }

  .build__links {
    display: flex;
    gap: var(--s-3);
  }

  @media (min-width: 60rem) {
    .build {
      grid-template-columns: minmax(0, 1fr) minmax(0, 18rem) 7.5rem;
      gap: var(--s-4);
      align-items: start;
    }

    .build__links {
      justify-content: flex-end;
    }
  }
</style>
