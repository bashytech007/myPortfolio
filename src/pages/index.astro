---
import Base from '../layouts/Base.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Terminal from '../components/Terminal.astro';
import WriteupList from '../components/WriteupList.astro';
import { getProjects, getWriteups } from '../lib/content';
import { links, site } from '../lib/site';

const projects = await getProjects();
const writeups = await getWriteups();
const featured = projects.filter((p) => p.data.featured);
const latestWriteups = writeups.slice(0, 2);
const contactLinks = [...links.contact, ...links.social];
---

<Base bodyClass="home">
  <div class="hero-band">
    <div class="container hero">
      <section class="hero__copy" aria-labelledby="hero-title">
        <p class="hero__id">
          <span class="hero__name">{site.name}</span>
          <span class="label hero__disciplines">
            {
              site.disciplines.map((item, i) => (
                <>
                  {i > 0 && <span aria-hidden="true"> · </span>}
                  <span class="hero__discipline">{item}</span>
                  {i < site.disciplines.length - 1 && <span class="visually-hidden">, </span>}
                </>
              ))
            }
          </span>
        </p>
        <h1 id="hero-title">{site.headline}</h1>
        <p class="lead">{site.intro}</p>
        <p class="hero__actions">
          <a class="btn btn--primary" href="/writeups">View write-ups</a>
          <a class="btn" href="#contact">Contact</a>
        </p>
        <ul class="hero__chips" aria-label="What I work on">
          {
            site.credentials.map((item) => (
              <li class="chip">
                <Icon name={item.icon as IconName} />
                {item.label}
              </li>
            ))
          }
        </ul>
      </section>

      <div class="hero__terminal">
        <Terminal projects={projects} writeups={writeups} />
      </div>
    </div>
  </div>

  <section id="work" class="band band--alt" aria-labelledby="work-title">
    <div class="container" data-reveal>
      <div class="section-head">
        <h2 id="work-title">Featured work</h2>
        <a class="text-link" href="/projects">All projects</a>
      </div>

      {
        latestWriteups.length > 0 ? (
          <div class="work__writeups">
            <div class="work__subhead">
              <p class="label">Latest write-ups</p>
              <a class="text-link" href="/writeups">
                All write-ups
              </a>
            </div>
            <WriteupList writeups={latestWriteups} level={3} />
          </div>
        ) : (
          <p class="work__note">
            Security case studies will be listed under <a href="/writeups">write-ups</a> as I publish
            them. Until then, these are builds from my time as a developer.
          </p>
        )
      }

      {latestWriteups.length > 0 && <p class="label work__builds">Builds</p>}
      <div class="project-grid">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section id="focus" class="band" aria-labelledby="focus-title">
    <div class="container focus" data-reveal>
      <div class="focus__head">
        <h2 id="focus-title">Focus areas</h2>
        <p>{site.focusIntro}</p>
      </div>
      <ol class="rows focus__list">
        {
          site.focus.map((item, i) => (
            <li>
              <span class="label label--accent" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="contact" class="band band--alt" aria-labelledby="contact-title">
    <div class="container contact" data-reveal>
      <div class="contact__head">
        <h2 id="contact-title">Contact</h2>
        <p>{site.contactIntro}</p>
        <p>Based in {site.location}.</p>
      </div>
      <ul class="rows contact__list">
        {
          contactLinks.map((item) => (
            <li>
              <a href={item.href} rel="me noopener noreferrer">
                <span class="label">{item.label}</span>
                <span class="contact__value">{item.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Hero */

  /* Full-width band so the grid can run edge to edge behind the content. */
  .hero-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    overflow: clip;
  }

  /* Fine-line grid, static, fading out before the next section. */
  .hero-band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    background-position: center top;
    -webkit-mask-image: linear-gradient(to bottom, #000, rgb(0 0 0 / 0.55) 45%, transparent 94%);
    mask-image: linear-gradient(to bottom, #000, rgb(0 0 0 / 0.55) 45%, transparent 94%);
    pointer-events: none;
  }

  .hero {
    display: grid;
    gap: var(--s-6);
    padding-block: var(--s-5) var(--s-8);
  }

  .hero__copy {
    min-width: 0;
  }

  .hero__id {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-block-end: var(--s-3);
  }

  .hero__name {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .hero__disciplines {
    text-wrap: balance;
  }

  .hero__discipline {
    white-space: nowrap;
  }

  .hero h1 {
    max-width: 22ch;
  }

  .hero .lead {
    margin-block-start: var(--s-3);
    color: var(--muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-block-start: var(--s-4);
  }

  /* Credential chips: plain statements of what I work on, no numbers. */

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    max-width: 26rem;
    margin-block-start: var(--s-3);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    padding-inline: 0.625rem 0.75rem;
    border: var(--hairline) solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    color: var(--text);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }

  .chip :global(.icon) {
    color: var(--muted);
  }

  /* The terminal sits on a soft accent glow. The glow is a plain gradient,
     not a blur filter, and does not move. */
  .hero__terminal {
    position: relative;
    min-width: 0;
  }

  .hero__terminal::before {
    content: '';
    position: absolute;
    inset: -45% -40%;
    z-index: -1;
    background: radial-gradient(
      closest-side,
      var(--glow),
      color-mix(in srgb, var(--glow) 45%, transparent) 55%,
      transparent
    );
    pointer-events: none;
  }

  @media (min-width: 30rem) {
    .hero__id {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--s-1) var(--s-2);
    }

    .hero__id .label {
      padding-inline-start: var(--s-2);
      border-inline-start: var(--hairline) solid var(--border-strong);
    }
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--s-6) var(--s-10);
    }

    .hero h1 {
      max-width: 20ch;
    }

    .hero__actions {
      margin-block-start: var(--s-5);
    }
  }

  /* Two columns: copy about 55%, terminal about 45%, centred on each other
     and sized so the whole hero fits one screen under the navigation. */
  @media (min-width: 64rem) {
    .hero {
      --hero-pad: var(--s-6);
      grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
      align-items: center;
      gap: var(--s-6);
      min-height: min(calc(100svh - var(--header-h) - 1px), 46rem);
      padding-block: var(--hero-pad);
    }

    .hero h1 {
      max-width: none;
      font-size: clamp(2.625rem, 1rem + 2.6vw, 3.25rem);
    }

    .hero .lead {
      max-width: 30em;
    }

    .hero__actions {
      margin-block-start: var(--s-4);
    }

    /* The window runs a little past the right edge of the content column. */
    .hero__terminal {
      margin-inline-end: calc(var(--s-2) * -1);
      --term-pad: 1.25rem;
      --term-size: 0.8125rem;
      --term-screen-max: none;
      --term-height: clamp(
        20rem,
        calc(100svh - var(--header-h) - 1px - var(--hero-pad) * 2),
        33rem
      );
    }
  }

  @media (min-width: 80rem) {
    .hero__terminal {
      margin-inline-end: calc(var(--s-4) * -1);
    }
  }

  /* Bands: each section runs the full width, with a hairline on its top edge
     and every other one a shade off the page background, so the sections
     read as separate without relying on whitespace alone. */

  .band {
    padding-block: var(--band-pad);
    border-block-start: var(--hairline) solid var(--border);
  }

  .band--alt {
    background: var(--bg-alt);
  }

  /* The last band runs straight into the footer. */
  :global(body.home .site-footer) {
    margin-block-start: 0;
  }

  /* Featured work */

  .work__note {
    max-width: var(--measure);
    margin-block: calc(var(--s-3) * -1) var(--s-5);
    color: var(--muted);
  }

  .work__writeups {
    margin-block-end: var(--s-6);
  }

  .work__subhead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2);
    margin-block-end: var(--s-2);
  }

  .work__builds {
    margin-block-end: var(--s-2);
  }

  /* Focus areas and contact share a two-column layout on wide screens. */

  .focus,
  .contact {
    display: grid;
    gap: var(--s-5);
  }

  .focus__head p,
  .contact__head p {
    max-width: 26em;
    margin-block-start: var(--s-2);
    color: var(--muted);
  }

  .contact__head p + p {
    margin-block-start: var(--s-1);
  }

  .focus__list li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--s-2);
    padding-block: var(--s-4);
  }

  .focus__list .label {
    line-height: 1.625rem;
  }

  .focus__list p {
    max-width: var(--measure);
    margin-block-start: var(--s-1);
    color: var(--muted);
  }

  .contact__list a {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--s-2);
    padding-block: 1.125rem;
    color: var(--text);
    text-decoration: none;
  }

  .contact__value {
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--border-strong);
    transition: text-decoration-color 120ms var(--ease);
  }

  .contact__list a:hover .contact__value {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  @media (min-width: 60rem) {
    .focus,
    .contact {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--s-8);
      align-items: start;
    }
  }
</style>
