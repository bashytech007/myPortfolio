---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHead from '../components/SectionHead.astro';
import WriteupList from '../components/WriteupList.astro';
import { getProjects, getWriteups } from '../lib/content';
import { currentJobs, experience, formatMonth, links, site, terminal } from '../lib/site';

const projects = await getProjects();
const writeups = await getWriteups();
// The home grid is screenshot-led, so it only takes projects that have one.
const selected = projects.filter((p) => p.data.featured && p.data.image);
const latestWriteups = writeups.slice(0, 2);
const contactLinks = [...links.contact, ...links.social];
const [firstName = site.name, ...restOfName] = site.name.split(' ');
const ticker = [...site.disciplines, ...site.credentials.map((item) => item.label)];

// Sections are numbered in the order they appear. Write-ups only take a
// number once there is something to list.
let count = 0;
const next = () => (count += 1);
const number = {
  work: next(),
  about: next(),
  experience: next(),
  focus: next(),
  writeups: latestWriteups.length > 0 ? next() : 0,
  contact: next(),
};
---

<Base bodyClass="home">
  <div class="hero-band">
    <section class="container hero" aria-labelledby="hero-title">
      <p class="label hero__roles">
        {
          site.roles.map((role, i) => (
            <>
              {i > 0 && <span class="hero__sep" aria-hidden="true"> / </span>}
              <span class="hero__role">{role}</span>
              {i < site.roles.length - 1 && <span class="visually-hidden">, </span>}
            </>
          ))
        }
      </p>

      <h1 id="hero-title" class="hero__name">
        <span class="hero__line"><span class="hero__word">{firstName}</span></span>
        {
          restOfName.length > 0 && (
            <span class="hero__line">
              <span class="hero__word">
                {restOfName.join(' ')}<span class="hero__cursor" aria-hidden="true" />
              </span>
            </span>
          )
        }
      </h1>

      <div class="hero__foot">
        <div class="hero__pitch">
          <p class="hero__statement">{site.headline}</p>
          <p class="hero__actions">
            <a class="btn btn--primary" href="#work">View work</a>
            <a class="btn" href={terminal.href}>
              <span class="btn__glyph" aria-hidden="true">&gt;_</span>
              Open the terminal
            </a>
          </p>
        </div>
        <dl class="hero__facts">
          <div>
            <dt class="label">Currently</dt>
            {currentJobs.map((job) => <dd>{job.org}</dd>)}
          </div>
          <div>
            <dt class="label">Based in</dt>
            <dd>{site.location}</dd>
          </div>
        </dl>
      </div>
    </section>
  </div>

  {/* A strip of work areas that drifts sideways. The second copy only exists
      to make the loop seamless and is hidden from assistive technology. */}
  <div class="ticker">
    <ul class="ticker__track" aria-label="What I work on">
      {ticker.map((item) => <li>{item}</li>)}
    </ul>
    <ul class="ticker__track" aria-hidden="true">
      {ticker.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  <section id="work" class="band" aria-labelledby="work-title">
    <div class="container">
      <SectionHead
        id="work-title"
        number={number.work}
        label="Work"
        title="Selected work"
        href="/projects"
        linkLabel="All projects"
      >
        {
          latestWriteups.length === 0 && (
            <p>
              Security case studies will be listed under <a href="/writeups">write-ups</a> as I
              publish them. Until then, this is the site itself and builds from my time as a
              developer.
            </p>
          )
        }
      </SectionHead>

      <div class="project-grid project-grid--stagger">
        {
          selected.map((project, i) => (
            <ProjectCard project={project} number={i + 1} priority={i === 0} />
          ))
        }
      </div>
    </div>
  </section>

  <section id="about" class="band" aria-labelledby="about-title">
    <div class="container" data-reveal>
      <SectionHead id="about-title" number={number.about} label="About" title={site.intro} />
      <div class="about">
        <dl class="about__facts">
          {
            site.roles.map((role, i) => (
              <div>
                <dt class="label">{i === 0 ? 'Role' : 'Also'}</dt>
                <dd>{role}</dd>
              </div>
            ))
          }
          <div>
            <dt class="label">Currently</dt>
            {currentJobs.map((job) => <dd>{job.org}</dd>)}
          </div>
          <div>
            <dt class="label">Location</dt>
            <dd>{site.location}</dd>
          </div>
        </dl>
        <div class="about__text">
          {site.about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section id="experience" class="band" aria-labelledby="experience-title">
    <div class="container" data-reveal>
      <SectionHead
        id="experience-title"
        number={number.experience}
        label="Experience"
        title={site.experienceIntro}
      />
      <ol class="rows experience">
        {
          experience.map((job) => (
            <li>
              <p class="label experience__dates">
                <time datetime={job.start}>{formatMonth(job.start)}</time>
                <span aria-hidden="true"> &ndash; </span>
                <span class="visually-hidden"> to </span>
                {job.end ? (
                  <time datetime={job.end}>{formatMonth(job.end)}</time>
                ) : (
                  <span class="label--accent">Present</span>
                )}
              </p>
              <h3>{job.role}</h3>
              <p class="experience__org">{job.org}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="focus" class="band" aria-labelledby="focus-title">
    <div class="container" data-reveal>
      <SectionHead id="focus-title" number={number.focus} label="Focus" title={site.focusIntro} />
      <ol class="rows focus">
        {
          site.focus.map((item, i) => (
            <li>
              <span class="focus__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    latestWriteups.length > 0 && (
      <section id="writeups" class="band" aria-labelledby="writeups-title">
        <div class="container" data-reveal>
          <SectionHead
            id="writeups-title"
            number={number.writeups}
            label="Write-ups"
            title="Latest write-ups"
            href="/writeups"
            linkLabel="All write-ups"
          />
          <WriteupList writeups={latestWriteups} level={3} />
        </div>
      </section>
    )
  }

  <section id="contact" class="band" aria-labelledby="contact-title">
    <div class="container" data-reveal>
      <SectionHead id="contact-title" number={number.contact} label="Contact" title="Get in touch">
        <p>{site.contactIntro}</p>
      </SectionHead>
      <ul class="rows contact">
        {
          contactLinks.map((item) => (
            <li>
              <a href={item.href} rel="me noopener noreferrer">
                <span class="label">{item.label}</span>
                <span class="contact__value">{item.text}</span>
                <span class="contact__arrow" aria-hidden="true">&#8599;</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Hero ----------------------------------------------------------------- */

  /* Full-width band so the grid can run edge to edge behind the content. */
  .hero-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    overflow: clip;
  }

  /* Fine-line grid, static, fading out before the next section. */
  .hero-band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 4rem 4rem;
    background-position: center top;
    -webkit-mask-image: linear-gradient(to bottom, #000, rgb(0 0 0 / 0.5) 50%, transparent 96%);
    mask-image: linear-gradient(to bottom, #000, rgb(0 0 0 / 0.5) 50%, transparent 96%);
    pointer-events: none;
  }

  /* One soft patch of the accent behind the name. A plain gradient, not a
     blur filter, and it does not move. */
  .hero-band::after {
    content: '';
    position: absolute;
    inset: -10% -70% auto -10%;
    z-index: -1;
    height: 100%;
    background: radial-gradient(closest-side, var(--glow), transparent);
    pointer-events: none;
  }

  @media (min-width: 60rem) {
    .hero-band::after {
      inset: -30% -20% auto 35%;
      height: 120%;
    }
  }

  .hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* One screen tall, but never stretched on a very tall window. */
    min-height: min(calc(100svh - var(--header-h)), 56rem);
    padding-block: var(--s-8) var(--s-5);
  }

  .hero__roles {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hero__sep {
    display: none;
  }

  /* The name: heavy, uppercase, set tight, sized to the viewport. */
  .hero__name {
    margin-block-start: var(--s-3);
    margin-inline-start: -0.04em;
    font-size: var(--text-display);
    font-weight: 800;
    line-height: 0.84;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    text-wrap: nowrap;
  }

  /* Each line is clipped so its word can rise into place. */
  .hero__line {
    display: block;
    overflow: hidden;
    overflow: clip;
  }

  .hero__word {
    display: inline-block;
  }

  /* A block cursor after the name, the same idea as the mark in the header. */
  .hero__cursor {
    display: inline-block;
    width: 0.26em;
    height: 0.725em;
    margin-inline-start: 0.11em;
    background: var(--accent);
  }

  .hero__foot {
    display: grid;
    gap: var(--s-5);
    margin-block-start: var(--s-6);
  }

  .hero__statement {
    max-width: 21em;
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-block-start: var(--s-4);
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
    padding-block-start: var(--s-3);
    border-block-start: var(--hairline) solid var(--border);
  }

  .hero__facts dd {
    margin-block-start: 0.25rem;
    font-size: var(--text-md);
    line-height: 1.4;
  }

  /* The entrance: one sequence, played once on load and over by 620ms. This
     is the only motion on the site allowed past the duration tokens.

       0ms  name, first line    rises inside its clip      520ms
      60ms  name, second line   the same                   520ms
     180ms  roles, statement    fade in, rising 8px        320ms
     240ms  both buttons        the same                   320ms
     300ms  facts               fade in                    320ms

     The name is never transparent, because it is the largest paint on the
     page. `both` holds each start state until its turn and the end state
     afterwards. With `backwards` the statement was repainted when its
     animation ended and counted as a later, larger paint. The end keyframe is
     implicit, so it follows the element's own styles. The animated elements
     are wrappers, so the buttons' hover and press states are untouched. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__word {
      animation: hero-rise 520ms var(--ease-out) both;
    }

    .hero__line + .hero__line .hero__word {
      animation-delay: 60ms;
    }

    .hero__roles,
    .hero__statement {
      animation: hero-arrive 320ms var(--ease-out) 180ms both;
    }

    .hero__actions {
      animation: hero-arrive 320ms var(--ease-out) 240ms both;
    }

    .hero__facts {
      animation: hero-fade 320ms var(--ease-out) 300ms both;
    }

    /* The cursor starts blinking a beat after everything has landed. */
    .hero__cursor {
      animation: hero-blink 1.2s steps(1, end) 1s infinite;
    }
  }

  /* Reduced motion: the name is simply there and the rest fades in, with no
     movement. The duration is restated to get past the site-wide rule that
     cuts every animation short under this setting. */
  @media (prefers-reduced-motion: reduce) {
    .hero__roles,
    .hero__foot {
      animation: hero-fade var(--dur-move) var(--ease) both;
      animation-duration: var(--dur-move) !important;
    }
  }

  @keyframes hero-rise {
    from {
      transform: translateY(100%);
    }
  }

  @keyframes hero-arrive {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes hero-blink {
    50% {
      opacity: 0;
    }
  }

  @media (min-width: 40rem) {
    .hero__roles {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 0.75em;
    }

    .hero__sep {
      display: inline;
      color: var(--accent);
    }
  }

  @media (min-width: 60rem) {
    .hero {
      padding-block: var(--s-10) var(--s-6);
    }

    .hero__name {
      margin-block-start: var(--s-4);
    }

    .hero__foot {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: var(--s-8);
      margin-block-start: var(--s-8);
    }

    .hero__statement {
      font-size: clamp(1.5rem, 1rem + 1.1vw, 1.875rem);
    }
  }

  /* Ticker ----------------------------------------------------------------- */

  .ticker {
    display: flex;
    gap: var(--s-6);
    padding-block: var(--s-3);
    border-block: var(--hairline) solid var(--border);
    overflow: hidden;
    user-select: none;
  }

  .ticker__track {
    flex: none;
    display: flex;
    align-items: center;
    gap: var(--s-6);
    min-width: 100%;
    justify-content: space-around;
    color: var(--muted);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }

  .ticker__track li {
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }

  .ticker__track li::after {
    content: '/';
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75em;
    font-weight: 500;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ticker__track {
      animation: ticker 48s linear infinite;
    }

    .ticker:focus-within .ticker__track {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .ticker:hover .ticker__track {
      animation-play-state: paused;
    }
  }

  /* Without motion the strip is a plain wrapped list. */
  @media (prefers-reduced-motion: reduce) {
    .ticker {
      padding-inline: var(--gutter);
    }

    .ticker__track {
      flex: 1;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: var(--s-1) var(--s-3);
      min-width: 0;
      white-space: normal;
    }

    .ticker__track li {
      gap: var(--s-3);
    }

    .ticker__track[aria-hidden] {
      display: none;
    }
  }

  @keyframes ticker {
    to {
      transform: translateX(calc(-100% - var(--s-6)));
    }
  }

  @media (min-width: 48rem) {
    .ticker {
      padding-block: var(--s-4);
    }

    .ticker__track {
      font-size: var(--text-2xl);
    }
  }

  /* Sections --------------------------------------------------------------- */

  .band {
    padding-block-start: var(--band-pad);
  }

  /* About: facts in a narrow column, the text beside them. */

  .about {
    display: grid;
    gap: var(--s-6);
  }

  .about__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
    align-content: start;
  }

  .about__facts dd {
    margin-block-start: 0.25rem;
    font-size: var(--text-md);
    line-height: 1.4;
  }

  .about__text {
    display: grid;
    gap: var(--s-3);
    max-width: var(--measure);
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--muted);
  }

  .about__text p:first-child {
    color: var(--text);
  }

  /* Experience: one row per role, newest first. Dates, role, organisation. */

  .experience li {
    display: grid;
    gap: 0.375rem;
    padding-block: var(--s-4);
  }

  .experience h3 {
    font-size: var(--text-xl);
    letter-spacing: -0.025em;
  }

  .experience__org {
    color: var(--muted);
  }

  /* Focus: a numbered list with large numerals. */

  .focus li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--s-1) var(--s-2);
    padding-block: var(--s-4);
  }

  .focus__num {
    grid-row: span 2;
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--muted);
    transition: color var(--dur) var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .focus li:hover .focus__num {
      color: var(--accent);
    }
  }

  .focus h3 {
    font-size: var(--text-xl);
    letter-spacing: -0.025em;
  }

  .focus p {
    max-width: var(--measure);
    color: var(--muted);
  }

  /* Contact: whole rows are links and change colour together. */

  .contact li {
    transition: border-color var(--dur) var(--ease);
  }

  .contact a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.25rem var(--s-2);
    padding-block: var(--s-3);
    color: var(--text);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .contact .label {
    grid-column: 1 / -1;
    transition: color var(--dur) var(--ease);
  }

  .contact__value {
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }

  .contact__arrow {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--muted);
    transition:
      color var(--dur) var(--ease),
      transform var(--dur-move) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact a:hover,
    .contact a:hover .label,
    .contact a:hover .contact__arrow {
      color: var(--accent);
    }

    .contact li:has(a:hover) {
      border-block-end-color: var(--accent);
    }
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .contact a:hover .contact__arrow {
      transform: translate(2px, -2px);
    }
  }

  @media (min-width: 60rem) {
    .about {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--s-8);
    }

    .about__facts {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }

    .experience li,
    .focus li {
      grid-template-columns: minmax(0, 2fr) minmax(0, 4fr) minmax(0, 6fr);
      align-items: baseline;
      gap: var(--s-4);
      padding-block: var(--s-5);
    }

    .focus__num {
      grid-row: auto;
      font-size: var(--text-3xl);
    }

    .contact a {
      grid-template-columns: minmax(0, 2fr) minmax(0, 10fr) auto;
      gap: var(--s-4);
      padding-block: var(--s-4);
    }

    .contact .label {
      grid-column: auto;
    }

    .contact__value {
      font-size: var(--text-2xl);
    }
  }
</style>
