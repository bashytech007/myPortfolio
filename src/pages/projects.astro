---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectRows from '../components/ProjectRows.astro';
import { getProjects } from '../lib/content';

const projects = await getProjects();
const security = projects.filter((p) => p.data.kind === 'security');
const development = projects.filter((p) => p.data.kind === 'development' && p.data.image);
const earlier = projects.filter((p) => p.data.kind === 'development' && !p.data.image);
---

<Base
  title="Projects"
  description="Things Bashir Aremu has built: security work, and the web and mobile apps from his time as a full-stack developer."
>
  <div class="container">
    <header class="page-head">
      <h1>Projects</h1>
      <p class="lead">
        Things I've built. The security work is recent. The development work is from my time as a
        full-stack developer.
      </p>
      <ul class="jump" aria-label="On this page">
        <li><a href="#security">Security</a></li>
        <li><a href="#development">Development</a></li>
        <li><a href="#earlier">Earlier builds</a></li>
      </ul>
    </header>

    <section id="security" class="section" aria-labelledby="security-title">
      <div class="section-head">
        <h2 id="security-title">Security</h2>
        <p>Tooling and hardening work.</p>
      </div>
      <div class="project-grid">
        {security.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section id="development" class="section" aria-labelledby="development-title" data-reveal>
      <div class="section-head">
        <h2 id="development-title">Development</h2>
        <p>Web apps I built or helped build as a developer.</p>
      </div>
      <div class="project-grid">
        {development.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section id="earlier" class="section" aria-labelledby="earlier-title" data-reveal>
      <div class="section-head">
        <h2 id="earlier-title">Earlier builds</h2>
        <p>Older front-end and mobile projects.</p>
      </div>
      <ProjectRows projects={earlier} />
    </section>
  </div>
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    margin-block-start: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
