---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import { getProjects, getWriteups } from '../lib/content';

const projects = await getProjects();
const writeups = await getWriteups();
---

<Base
  title="Terminal"
  description="The portfolio as a terminal: list projects and write-ups, read the security headers this site sends, and look for the hidden flags."
  bodyClass="term-page"
  bare
>
  <h1 class="visually-hidden">Terminal</h1>
  <Terminal projects={projects} writeups={writeups} />
</Base>
