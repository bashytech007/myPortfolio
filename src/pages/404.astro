---
import Base from '../layouts/Base.astro';
import { nav, terminal } from '../lib/site';
---

<Base title="Page not found" description="There is no page at this address." noindex>
  <div class="container notfound">
    <p class="label"><span class="label--accent">404</span> / Not found</p>
    <h1>Command not found</h1>
    <p class="lead">There is no page at this address. It may have moved, or the link may be wrong.</p>

    <div class="notfound__session" role="img" aria-label="A terminal showing: no such page">
      <p aria-hidden="true">
        <span class="notfound__prompt">$</span>
        <span data-not-found-path>cd /this-page</span>
      </p>
      <p class="notfound__out" aria-hidden="true">no such page</p>
    </div>

    <p class="notfound__actions">
      <a class="btn btn--primary" href="/">Go home</a>
      {
        nav
          .filter((item) => !item.href.includes('#'))
          .map((item) => (
            <a class="btn" href={item.href}>
              {item.label}
            </a>
          ))
      }
      <a class="btn" href={terminal.href}>
        <span class="btn__glyph" aria-hidden="true">&gt;_</span>
        {terminal.label}
      </a>
    </p>
  </div>
</Base>

<script>
  // Show the address that was asked for. Inserted as text, never as HTML.
  const target = document.querySelector<HTMLElement>('[data-not-found-path]');
  if (target) {
    let path = location.pathname;
    try {
      path = decodeURI(path);
    } catch {
      // Keep the raw path if it is not valid percent-encoding.
    }
    target.textContent = `cd ${path.length > 60 ? `${path.slice(0, 60)}...` : path}`;
  }
</script>

<style>
  .notfound {
    padding-block-start: var(--s-8);
  }

  .notfound h1 {
    margin-block-start: var(--s-3);
    font-size: clamp(2.5rem, 1.5rem + 4.4vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .notfound .lead {
    margin-block-start: var(--s-4);
  }

  /* Two lines of a shell session between hairlines. */
  .notfound__session {
    max-width: 40rem;
    margin-block-start: var(--s-6);
    padding-block: var(--s-3);
    border-block: var(--hairline) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .notfound__prompt {
    color: var(--accent);
    font-weight: 600;
  }

  .notfound__out {
    color: var(--muted);
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-block-start: var(--s-6);
  }

  @media (min-width: 48rem) {
    .notfound {
      padding-block-start: var(--s-14);
    }
  }
</style>
